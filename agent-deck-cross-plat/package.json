{
  "name": "agent-deck-cross-plat",
  "private": true,
  "version": "0.0.1",
  "description": "Cross-platform Agent Deck: Node/TypeScript core + web UI on top of the pi coding agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:pi": "pnpm -r test:pi",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "eslint": "9.30.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  }
}
